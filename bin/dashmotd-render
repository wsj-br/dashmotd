#!/usr/bin/env bash
# Render the dashmotd dashboard: banner + LAYOUT grid.
# Live sections (LIVE_SECTIONS) are sampled now; other cells come from
# cache/sections/ written by dashmotd-collect. Invoked at login / display.
#
# Copyright (c) 2026 Waldemar Scudeller Junior.  Licensed under MIT License

set -euo pipefail

# pam_motd invokes us via env -i; ensure UTF-8 for °C and column layout.
export LANG="${LANG:-C.UTF-8}"
export LC_ALL="${LC_ALL:-C.UTF-8}"

ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
export DASHMOTD_ROOT="$ROOT"
export DASHMOTD_CACHE="${DASHMOTD_CACHE:-$ROOT/cache}"
# Cache is normally root-owned (/opt/dashmotd); login render runs as the user.
mkdir -p "$DASHMOTD_CACHE" 2>/dev/null || true

# shellcheck source=/dev/null
source "$ROOT/config"
# shellcheck source=/dev/null
source "$ROOT/lib/colors.sh"
# shellcheck source=/dev/null
source "$ROOT/lib/column.sh"
# shellcheck source=/dev/null
source "$ROOT/lib/layout.sh"

banner_file="$DASHMOTD_CACHE/banner"
if [[ ! -s "$banner_file" ]]; then
    # May fail as non-root; sections still render without a banner.
    "$ROOT/bin/dashmotd-banner" >/dev/null 2>&1 || true
fi

mapfile -t layout_rows < <(dashmotd_layout_rows)

cols="${GRID_COLUMNS:-2}"

declare -a col_text
for (( c = 1; c <= cols; c++ )); do
    col_text[$c]=""
done

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

section_output() {
    local name="$1" script cache_file
    script="$(dashmotd_resolve_section "$name" || true)"
    [[ -z "$script" ]] && return 0

    cache_file="$DASHMOTD_CACHE/sections/$name"
    if dashmotd_is_live "$name" || [[ ! -r "$cache_file" ]]; then
        # Live keys always run now; missing cache falls back to a live run
        # (covers first boot before dashmotd-collect has executed).
        "$script" 2>/dev/null || true
    else
        cat "$cache_file"
    fi
}

for row in "${layout_rows[@]}"; do
    IFS='|' read -r -a cells <<< "$row"
    for (( c = 1; c <= cols; c++ )); do
        cell="${cells[$((c - 1))]:-}"
        name="$(dashmotd_trim "$cell")"
        [[ -z "$name" ]] && continue
        col_text[$c]+="$(section_output "$name")"$'\n'
    done
done

for (( c = 1; c <= cols; c++ )); do
    printf '%s' "${col_text[$c]}" > "$tmpdir/col$c"
done

merged=""
if (( cols == 1 )); then
    merged="$(cat "$tmpdir/col1")"
else
    paste_args=()
    for (( c = 1; c <= cols; c++ )); do
        paste_args+=("$tmpdir/col$c")
    done
    # ANSI-aware merge (util-linux column < 2.40 mis-counts CSI width).
    merged="$(dashmotd_merge_columns "${paste_args[@]}")"
fi

{
    [[ -s "$banner_file" ]] && cat "$banner_file"
    printf '%s\n' "$merged"
    printf '\n'
} | {
    # Always print to stdout for login/MOTD. Refresh cache/motd only when writable
    # (root/timer/install); never fail the display on Permission denied.
    if [[ -w "$DASHMOTD_CACHE/motd" ]] || { [[ ! -e "$DASHMOTD_CACHE/motd" ]] && [[ -w "$DASHMOTD_CACHE" ]]; }; then
        tee "$DASHMOTD_CACHE/motd"
    else
        cat
    fi
}
