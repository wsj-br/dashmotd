#!/bin/sh
# update-motd.d entry: optional static /etc/motd preamble, then dashboard.
#
# pam_motd prints /run/motd.dynamic first, then /etc/motd. The installer
# backs up and blanks /etc/motd so the legal/admin text is not shown after
# the dashboard; we print the backup here so it appears before instead.
#
# pam_motd also runs this for non-interactive sessions (scp/sftp/git-over-ssh).
# Do not require a controlling terminal here: Debian runs update-motd scripts
# through pam_motd before the SSH session's terminal is attached, even for an
# interactive login. The caller decides whether MOTD output is displayed.
#
# Also skip when this tty/session already showed the dashboard (nested shells,
# sudo su -) — see lib/once.sh.
#
# Copyright (c) 2026 Waldemar Scudeller Junior.  Licensed under MIT License

# pam_motd runs this via `env -i` (no LANG). Force UTF-8 for °C etc.
LANG="${LANG:-C.UTF-8}"
LC_ALL="${LC_ALL:-C.UTF-8}"
export LANG LC_ALL

STATIC="${DASHMOTD_STATIC_MOTD:-/etc/motd.dashmotd.bak}"
RENDER="${DASHMOTD_RENDER:-/opt/dashmotd/bin/dashmotd-render}"
FALLBACK="${DASHMOTD_MOTD:-/opt/dashmotd/cache/motd}"

# Resolve lib/once.sh next to the render binary (or DASHMOTD_ONCE_LIB override).
ONCE_LIB="${DASHMOTD_ONCE_LIB:-}"
if [ -z "$ONCE_LIB" ] && [ -n "$RENDER" ]; then
    ONCE_LIB="$(dirname "$RENDER")/../lib/once.sh"
fi
if [ -z "$ONCE_LIB" ]; then
    ONCE_LIB=/opt/dashmotd/lib/once.sh
fi
if [ -r "$ONCE_LIB" ]; then
    # shellcheck source=/dev/null
    . "$ONCE_LIB"
    if ! dashmotd_once_should_display; then
        exit 0
    fi
fi

# Skip preamble when install used --no-static-motd (marker absent).
if [ -e /opt/dashmotd/show-static-motd ] && [ -s "$STATIC" ]; then
    cat "$STATIC"
    echo
fi

if [ -x "$RENDER" ]; then
    "$RENDER"
elif [ -r "$FALLBACK" ]; then
    cat "$FALLBACK"
fi
